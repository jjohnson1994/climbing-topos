# AWS credentials (if not using ~/.aws/credentials or env vars set elsewhere)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region - defaults to eu-west-1
AWS_REGION=eu-west-1

# Dev DynamoDB table name - resolved automatically from SST when running via `npx sst dev`
# Only needed if running outside SST
DYNAMODB_TABLE=climbingtopos2

# Production DynamoDB table name - required to use the production environment switcher
# Find this in the AWS console or via: aws dynamodb list-tables
PRODUCTION_TABLE_NAME=production-climbingtopos2

# S3 bucket name for image uploads - resolved automatically from SST when running via `npx sst dev`
# Only needed if running outside SST
S3_BUCKET_NAME=

# CloudFront CDN URL for serving images - resolved automatically from SST when running via `npx sst dev`
# Only needed if running outside SST (find in AWS CloudFront console)
IMAGES_CDN_URL=

# Production S3 bucket name - required when running the image URL migration against production
# Find via AWS S3 console or: aws s3 ls
PRODUCTION_S3_BUCKET_NAME=

# Production CloudFront CDN URL - required when running the image URL migration against production
# Find via AWS CloudFront console after deploying to production
PRODUCTION_IMAGES_CDN_URL=
