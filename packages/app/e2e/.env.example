# Base URL for the app under test (default: http://localhost:3000)
# For e2e stage: set to the deployed URL from `sst output --stage e2e`
BASE_URL=http://localhost:3000

# Test user credentials (must be a fully set-up account: verified email + profile picture)
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=password123

# Test data slugs — must exist in the target environment's database
# Used for route-detail, log-route, lists, create-area, create-topo, create-route tests
E2E_TEST_CRAG_SLUG=test-crag
E2E_TEST_AREA_SLUG=test-area
E2E_TEST_TOPO_SLUG=test-topo

# Full path to a specific route for log-route and save-to-list tests
E2E_TEST_ROUTE_URL=/crags/test-crag/areas/test-area/topos/test-topo/routes/test-route

# MailSlurp API key for signup flow tests (free at mailslurp.com)
MAILSLURP_API_KEY=your-api-key-here
