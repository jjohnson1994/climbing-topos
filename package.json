{
  "name": "climbingtopos",
  "version": "1.0.0",
  "description": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "sst dev",
    "test:e2e": "cd packages/app && npx playwright test",
    "test:e2e:ui": "cd packages/app && npx playwright test --ui",
    "test:e2e:report": "cd packages/app && npx playwright show-report",
    "test:e2e:deploy": "sst deploy --stage e2e"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier"
    ],
    "*.{ts,tsx}": "tsc-files --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@tsconfig/recommended": "^1.0.7",
    "copy-dynamodb-table": "^2.2.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "sst": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.8.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
